{
  "kind": "collectionType",
  "collectionName": "interests",
  "info": {
    "singularName": "interest",
    "pluralName": "interests",
    "displayName": "Interest",
    "description": "Centre d'intérêt rattaché à une catégorie (Sport → Badminton)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 60
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::interest-category.interest-category",
      "inversedBy": "interests"
    },
    "users": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "interestTags"
    }
  }
}
