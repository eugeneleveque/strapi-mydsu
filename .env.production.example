# Modèle du fichier /opt/bondiz/.env sur le VPS.
# Ne jamais commiter le fichier rempli.
# Générer chaque secret avec : openssl rand -base64 32

# Serveur
HOST=0.0.0.0
PORT=1337

# Secrets Strapi
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=
# Signe les jetons de l'espace partenaire (blog). Optionnel : dérivé de JWT_SECRET sinon.
PARTNER_JWT_SECRET=

# Base de données PostgreSQL (Supabase)
DATABASE_CLIENT=postgres
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Stockage des images
#
# Par défaut (bloc ci-dessous laissé commenté), les fichiers sont écrits dans
# public/uploads, conservé par le volume `uploads` du conteneur.
#
# Pour basculer sur Supabase Storage plus tard : créer le bucket, décommenter
# ces variables, puis migrer les fichiers existants avec
# `node scripts/migrate-uploads-to-supabase.js` (voir deploy/README.md).
# Tant que SUPABASE_API_URL est vide, Supabase n'est pas utilisé.
#
# SUPABASE_API_URL=
# SUPABASE_API_KEY=
# SUPABASE_BUCKET=user_photos
# SUPABASE_DIRECTORY=
# SUPABASE_PUBLIC_FILES=true
# SUPABASE_SIGNED_URL_EXPIRES=3600

# Taille maximale d'un envoi de fichier, en octets (10 Mo).
# À garder cohérente avec client_max_body_size dans Nginx.
UPLOAD_SIZE_LIMIT=10485760

# Notifications push (Web Push)
# Sans ces trois variables, les notifications sont désactivées.
# Générer la paire de clés une seule fois avec : npx web-push generate-vapid-keys
# Changer de clés invalide tous les abonnements existants.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresse de contact transmise aux services de push (mailto: ou https://).
VAPID_SUBJECT=mailto:vous@example.com
